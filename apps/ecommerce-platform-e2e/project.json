{
  "name": "ecommerce-platform-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["ecommerce-platform"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "dependsOn": ["ecommerce-platform:build", "ecommerce-platform:serve"],
      "options": {
        "jestConfig": "apps/ecommerce-platform-e2e/jest.config.cts",
        "passWithNoTests": true
      }
    }
  }
}
