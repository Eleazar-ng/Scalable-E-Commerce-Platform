# Copy this file to .env before running `docker-compose up`.
# Real .env files are gitignored - never commit actual secrets.

# --- Postgres (one instance per service) ---
# Connection strings each service's Prisma schema will use, per the
# per-service .env convention documented in docs/03_prisma_conventions.md
USER_SERVICE_DATABASE_URL="postgresql://user_service:user_service_dev_password@localhost:5432/user_service_db"
CATALOG_SERVICE_DATABASE_URL="postgresql://catalog_service:catalog_service_dev_password@localhost:5433/catalog_service_db"
CART_SERVICE_DATABASE_URL="postgresql://cart_service:cart_service_dev_password@localhost:5434/cart_service_db"
ORDER_SERVICE_DATABASE_URL="postgresql://order_service:order_service_dev_password@localhost:5435/order_service_db"
PAYMENT_SERVICE_DATABASE_URL="postgresql://payment_service:payment_service_dev_password@localhost:5436/payment_service_db"
NOTIFICATION_SERVICE_DATABASE_URL="postgresql://notification_service:notification_service_dev_password@localhost:5437/notification_service_db"

# --- Kafka ---
# Use KAFKA_BROKERS_HOST from a service running on your host machine (e.g.
# during `nx serve`); use KAFKA_BROKERS_DOCKER if the service itself is
# later containerized and joins the same Compose network.
KAFKA_BROKERS_HOST="localhost:29092"
KAFKA_BROKERS_DOCKER="kafka:9092"

# --- Redis ---
REDIS_URL="redis://:redis_dev_password@localhost:6379"

# --- Stripe (Payment Service, Stage 4) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- JWT (User Service, Stage 2) ---
# Generate a real RSA/EC keypair when building User Service - these are
# placeholders documenting the expected shape.
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="7d"

# --- Notification adapter (Notification Service, Stage 6) ---
RESEND_API_KEY=""
